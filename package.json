{
  "name": "heimaa-accounting",
  "version": "1.0.0",
  "description": "黑马记账 - 个人桌面记账应用",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/server.ts\"",
    "dev:all": "tsx start.ts",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:web && npm run build:electron",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win",
    "start": "tsx start.ts",
    "server": "tsx server/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "antd": "^5.20.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.0",
    "express": "^4.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sql.js": "^1.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "main": "dist-electron/electron/main.js",
  "build": {
    "appId": "com.heimaa.accounting",
    "productName": "黑马记账",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "黑马记账-安装版-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "黑马记账",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "黑马记账-免安装版-${version}-${arch}.${ext}"
    }
  }
}
